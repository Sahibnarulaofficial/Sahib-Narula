# Resend API key - get from resend.com/dashboard
RESEND_API_KEY=re_your_api_key_here

# Email that receives contact form submissions
CONTACT_TO_EMAIL=hello@sahibnarula.com

# Email used as sender (must be verified in Resend)
CONTACT_FROM_EMAIL=noreply@yourdomain.com

# Port the backend listens on
PORT=5000

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# AI Chatbot Assistant (Blub) / LangChain Configuration
# ─────────────────────────────────────────────────────────────

# LLM Provider: 'groq' (default) | 'openai' | 'google'
LLM_PROVIDER=groq

# Groq API Key (or set GROQ_API_KEY)
LLM_API_KEY=gsk_your_groq_api_key_here

# Model Name (e.g. 'openai/gpt-oss-120b' or 'llama-3.3-70b-versatile')
LLM_MODEL=openai/gpt-oss-120b

# Model Temperature (0.0 to 1.0)
LLM_TEMPERATURE=0.3

# Chat Rate Limiting (Optional)
CHAT_RATE_LIMIT_WINDOW_MS=900000
CHAT_RATE_LIMIT_MAX=30
